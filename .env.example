# Copy to .env and fill in. Never commit .env.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your personal Telegram chat id. Send /start to the bot once and it will
# reply with the id if this is left empty (see README).
OWNER_CHAT_ID=

# Google AI Studio key. Only used to read Facebook group posts, which are free
# text and need a model to turn into structured listings. Leave blank and the
# Facebook source simply stays switched off; every other source works without it.
GEMINI_API_KEY=

# Minutes between poll cycles. The cheap JSON/HTML sources run every cycle;
# each slow or risky source declares its own minimum interval in minutes, so
# shortening this does not make them run more often.
POLL_MINUTES=5

DB_PATH=./data/apartment.db
LOG_LEVEL=info

# Set to 1 only after `npm run fb-login` has succeeded. Facebook stays off
# otherwise, because a profile directory alone does not prove a live session.
FACEBOOK_ENABLED=0

# Boards to read, comma separated (e.g. yad2,madlan). Unset means all of them.
SOURCES=

# Port of the /map page, served on the local network.
MAP_PORT=8787
